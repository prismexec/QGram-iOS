+/// Keeps PrismGram attributes when a message is overwritten by a fresh server copy
+/// (history refetch, channel validation, any full update).
+func prismMergeMessageAttributes(_ previous: [MessageAttribute], _ updated: inout [MessageAttribute]) {
+    if !updated.contains(where: { $0 is PrismEditHistoryMessageAttribute }), let history = previous.first(where: { $0 is PrismEditHistoryMessageAttribute }) {
+        updated.append(history)
+    }
+    if !updated.contains(where: { $0 is PrismDeletedMessageAttribute }), let deleted = previous.first(where: { $0 is PrismDeletedMessageAttribute }) {
+        updated.append(deleted)
+    }
+}
+
+func prismHideSponsoredMessages() -> Bool {
