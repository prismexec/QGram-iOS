diff --git a/submodules/TelegramCore/Sources/PrismGram/PrismGramGhostActions.swift b/submodules/TelegramCore/Sources/PrismGram/PrismGramGhostActions.swift
new file mode 100644
index 00000000..35653f9f
--- /dev/null
+++ b/submodules/TelegramCore/Sources/PrismGram/PrismGramGhostActions.swift
@@ -0,0 +1,94 @@
+// MARK: PrismGram
+import Foundation
+import Postbox
+import SwiftSignalKit
+import TelegramApi
+import SGSimpleSettings
+
+/// Tells the server that everything currently read locally in `peerId` is read,
+/// even while ghost mode hides read receipts.
+func prismSendReadReceipt(account: Account, peerId: PeerId) -> Signal<Never, NoError> {
+    let network = account.network
+    let stateManager = account.stateManager
+    return account.postbox.transaction { transaction -> (Peer?, Int32?) in
+        guard let peer = transaction.getPeer(peerId) else {
+            return (nil, nil)
+        }
+        var maxIncomingReadId: Int32?
+        if let states = transaction.getPeerReadStates(peerId) {
+            for (namespace, state) in states where namespace == Namespaces.Message.Cloud {
+                if case let .idBased(maxId, _, _, _, _) = state {
+                    maxIncomingReadId = maxId
+                }
+            }
+        }
+        return (peer, maxIncomingReadId)
+    }
+    |> mapToSignal { peer, maxIncomingReadId -> Signal<Never, NoError> in
+        guard let peer = peer, let maxIncomingReadId = maxIncomingReadId, maxIncomingReadId > 0 else {
+            return .complete()
+        }
+        if peer.id.namespace == Namespaces.Peer.CloudChannel {
+            guard let inputChannel = apiInputChannel(peer) else {
+                return .complete()
+            }
+            return network.request(Api.functions.channels.readHistory(channel: inputChannel, maxId: maxIncomingReadId))
+            |> `catch` { _ -> Signal<Api.Bool, NoError> in
+                return .complete()
+            }
+            |> ignoreValues
+        } else if peer.id.namespace == Namespaces.Peer.CloudUser || peer.id.namespace == Namespaces.Peer.CloudGroup {
+            guard let inputPeer = apiInputPeer(peer) else {
+                return .complete()
+            }
+            return network.request(Api.functions.messages.readHistory(peer: inputPeer, maxId: maxIncomingReadId))
+            |> map(Optional.init)
+            |> `catch` { _ -> Signal<Api.messages.AffectedMessages?, NoError> in
+                return .single(nil)
+            }
+            |> mapToSignal { result -> Signal<Never, NoError> in
+                if let result = result {
+                    switch result {
+                    case let .affectedMessages(affectedMessagesData):
+                        stateManager?.addUpdateGroups([.updatePts(pts: affectedMessagesData.pts, ptsCount: affectedMessagesData.ptsCount)])
+                    }
+                }
+                return .complete()
+            }
+        } else {
+            return .complete()
+        }
+    }
+}
+
+/// Ghost mode + "read on reply": writing to a chat reveals that you read it anyway.
+func prismReadOnReplyIfNeeded(account: Account, peerId: PeerId) {
+    guard prismGhostNoReadReceipts() && SGSimpleSettings.shared.prismGhostReadOnReply else {
+        return
+    }
+    let _ = prismSendReadReceipt(account: account, peerId: peerId).start()
+}
+
+/// The server marks you online when you send a message. In ghost mode go back offline right away.
+func prismGoOfflineAfterSendingIfNeeded(network: Network) {
+    guard prismGhostNoOnline() else {
+        return
+    }
+    let _ = (network.request(Api.functions.account.updateStatus(offline: .boolTrue))
+    |> `catch` { _ -> Signal<Api.Bool, NoError> in
+        return .single(.boolFalse)
+    }).start()
+}
+
+public extension TelegramEngine {
+    /// Sends a read receipt for `peerId` even while ghost mode is on.
+    func prismSendReadReceipt(peerId: EnginePeer.Id) -> Signal<Never, NoError> {
+        return PrismGramCore.sendReadReceipt(account: self.account, peerId: peerId)
+    }
+}
+
+enum PrismGramCore {
+    static func sendReadReceipt(account: Account, peerId: PeerId) -> Signal<Never, NoError> {
+        return prismSendReadReceipt(account: account, peerId: peerId)
+    }
+}
