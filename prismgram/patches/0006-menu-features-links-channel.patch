+/// Joins the PrismGram channel once per account, right after the account is ready.
+/// If the user leaves the channel later, PrismGram does not join it again.
+public func prismGramJoinChannelIfNeeded(context: AccountContext) {
+    let key = "prismgram_joined_channel_\(context.account.peerId.id._internalGetInt64Value())"
+    if UserDefaults.standard.bool(forKey: key) {
+        return
+    }
+    let _ = (context.engine.peers.resolvePeerByName(name: prismGramChannelUsername, referrer: nil)
+    |> mapToSignal { result -> Signal<EnginePeer?, NoError> in
+        if case let .result(peer) = result {
+            return .single(peer)
+        }
+        return .complete()
+    }
+    |> take(1)
+    |> deliverOnMainQueue).startStandalone(next: { peer in
+        guard let peer = peer, case .channel = peer else {
+            return
+        }
+        UserDefaults.standard.set(true, forKey: key)
+        let _ = context.engine.peers.joinChannel(peerId: peer.id, hash: nil).startStandalone()
+    })
 }
