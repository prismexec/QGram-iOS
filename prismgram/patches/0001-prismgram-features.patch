diff --git a/submodules/TelegramCore/Sources/PrismGram/PrismGramMessageAttributes.swift b/submodules/TelegramCore/Sources/PrismGram/PrismGramMessageAttributes.swift
new file mode 100644
index 00000000..ab439142
--- /dev/null
+++ b/submodules/TelegramCore/Sources/PrismGram/PrismGramMessageAttributes.swift
@@ -0,0 +1,160 @@
+// MARK: PrismGram
+import Foundation
+import Postbox
+import SGSimpleSettings
+
+/// Set on a message that was deleted on the server but kept locally ("saved deleted message").
+public final class PrismDeletedMessageAttribute: MessageAttribute {
+    public let date: Int32
+
+    public init(date: Int32) {
+        self.date = date
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        self.date = decoder.decodeInt32ForKey("d", orElse: 0)
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt32(self.date, forKey: "d")
+    }
+}
+
+/// Previous versions of an edited message, oldest first.
+public final class PrismEditHistoryMessageAttribute: MessageAttribute {
+    public struct Entry: Equatable {
+        public let date: Int32
+        public let text: String
+
+        public init(date: Int32, text: String) {
+            self.date = date
+            self.text = text
+        }
+    }
+
+    public let entries: [Entry]
+
+    public init(entries: [Entry]) {
+        self.entries = entries
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        let dates = decoder.decodeInt32ArrayForKey("ds")
+        let texts = decoder.decodeStringArrayForKey("ts")
+        var entries: [Entry] = []
+        for i in 0 ..< min(dates.count, texts.count) {
+            entries.append(Entry(date: dates[i], text: texts[i]))
+        }
+        self.entries = entries
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt32Array(self.entries.map { $0.date }, forKey: "ds")
+        encoder.encodeStringArray(self.entries.map { $0.text }, forKey: "ts")
+    }
+}
+
+public extension Message {
+    var prismIsDeleted: Bool {
+        return self.attributes.contains(where: { $0 is PrismDeletedMessageAttribute })
+    }
+
+    var prismEditHistory: [PrismEditHistoryMessageAttribute.Entry] {
+        for attribute in self.attributes {
+            if let attribute = attribute as? PrismEditHistoryMessageAttribute {
+                return attribute.entries
+            }
+        }
+        return []
+    }
+}
+
+public extension EngineMessage {
+    var prismIsDeleted: Bool {
+        return self.attributes.contains(where: { $0 is PrismDeletedMessageAttribute })
+    }
+
+    var prismEditHistory: [PrismEditHistoryMessageAttribute.Entry] {
+        for attribute in self.attributes {
+            if let attribute = attribute as? PrismEditHistoryMessageAttribute {
+                return attribute.entries
+            }
+        }
+        return []
+    }
+}
+
+private let prismMaxEditHistoryEntries = 50
+
+/// Builds the attribute list for an edited message so the previous text is kept.
+func prismAttributesPreservingEditHistory(previousMessage: Message, updatedText: String, updatedAttributes: [MessageAttribute]) -> [MessageAttribute] {
+    var attributes = updatedAttributes
+    attributes.removeAll(where: { $0 is PrismEditHistoryMessageAttribute || $0 is PrismDeletedMessageAttribute })
+
+    var entries = previousMessage.prismEditHistory
+    if SGSimpleSettings.shared.prismSaveEditHistory && previousMessage.text != updatedText && !previousMessage.text.isEmpty {
+        let previousDate = previousMessage.editedTime ?? previousMessage.timestamp
+        entries.append(PrismEditHistoryMessageAttribute.Entry(date: previousDate, text: previousMessage.text))
+        if entries.count > prismMaxEditHistoryEntries {
+            entries.removeFirst(entries.count - prismMaxEditHistoryEntries)
+        }
+    }
+    if !entries.isEmpty {
+        attributes.append(PrismEditHistoryMessageAttribute(entries: entries))
+    }
+    if let deleted = previousMessage.attributes.first(where: { $0 is PrismDeletedMessageAttribute }) {
+        attributes.append(deleted)
+    }
+    return attributes
+}
+
+/// When "save deleted messages" is on, marks the given cloud messages as deleted instead of removing them.
+/// Returns the ids that still have to be removed from the local database.
+func prismKeepDeletedMessages(transaction: Transaction, ids: [MessageId]) -> [MessageId] {
+    if !SGSimpleSettings.shared.prismSaveDeletedMessages {
+        return ids
+    }
+    let timestamp = Int32(CFAbsoluteTimeGetCurrent() + NSTimeIntervalSince1970)
+    var remaining: [MessageId] = []
+    for id in ids {
+        guard id.namespace == Namespaces.Message.Cloud, id.peerId.namespace != Namespaces.Peer.SecretChat, let message = transaction.getMessage(id) else {
+            remaining.append(id)
+            continue
+        }
+        if message.prismIsDeleted {
+            continue
+        }
+        // Service messages (joins, pins, etc.) are not worth keeping.
+        if message.media.contains(where: { $0 is TelegramMediaAction }) {
+            remaining.append(id)
+            continue
+        }
+        transaction.updateMessage(id, update: { currentMessage in
+            var storeForwardInfo: StoreMessageForwardInfo?
+            if let forwardInfo = currentMessage.forwardInfo {
+                storeForwardInfo = StoreMessageForwardInfo(forwardInfo)
+            }
+            var attributes = currentMessage.attributes
+            attributes.append(PrismDeletedMessageAttribute(date: timestamp))
+            return .update(StoreMessage(id: currentMessage.id, customStableId: nil, globallyUniqueId: currentMessage.globallyUniqueId, groupingKey: currentMessage.groupingKey, threadId: currentMessage.threadId, timestamp: currentMessage.timestamp, flags: StoreMessageFlags(currentMessage.flags), tags: currentMessage.tags, globalTags: currentMessage.globalTags, localTags: currentMessage.localTags, forwardInfo: storeForwardInfo, authorId: currentMessage.author?.id, text: currentMessage.text, attributes: attributes, media: currentMessage.media))
+        })
+    }
+    return remaining
+}
+
+// MARK: PrismGram ghost mode
+func prismGhostNoReadReceipts() -> Bool {
+    return SGSimpleSettings.shared.prismGhostNoReadReceipts
+}
+
+func prismGhostNoOnline() -> Bool {
+    return SGSimpleSettings.shared.prismGhostNoOnline
+}
+
+func prismGhostNoTyping() -> Bool {
+    return SGSimpleSettings.shared.prismGhostNoTyping
+}
+
+func prismGhostNoStoryViews() -> Bool {
+    return SGSimpleSettings.shared.prismGhostNoStoryViews
+}
