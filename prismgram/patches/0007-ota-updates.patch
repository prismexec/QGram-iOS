+// MARK: PrismGram OTA: compare the installed build with the latest published one.
+private struct PrismGramRelease {
+    let version: String
+    let build: Int
+    let downloadURL: String
+}
+
+private func prismGramParseRelease(_ data: Data) -> PrismGramRelease? {
+    guard let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+          let apps = json["apps"] as? [[String: Any]],
+          let app = apps.first,
+          let versions = app["versions"] as? [[String: Any]],
+          let latest = versions.first,
+          let buildString = latest["buildVersion"] as? String,
+          let build = Int(buildString),
+          let downloadURL = latest["downloadURL"] as? String else {
+        return nil
+    }
+    let version = (latest["version"] as? String) ?? ""
+    return PrismGramRelease(version: version, build: build, downloadURL: downloadURL)
+}
+
+/// Checks for a newer PrismGram build. Automatic checks run at most every 6 hours and stay silent
+/// unless an update exists; a manual check always reports the result.
+public func prismGramCheckForUpdates(context: AccountContext, manual: Bool) {
+    let now = Date().timeIntervalSince1970
+    if !manual {
+        if UserDefaults.standard.bool(forKey: prismGramUpdateCheckDisabledKey) {
+            return
+        }
+        if now - UserDefaults.standard.double(forKey: prismGramLastUpdateCheckKey) < 6 * 60 * 60 {
+            return
+        }
+    }
+    UserDefaults.standard.set(now, forKey: prismGramLastUpdateCheckKey)
+    guard let url = URL(string: prismGramUpdateSourceURL) else {
+        return
+    }
+    let currentBuild = Int((Bundle.main.infoDictionary?["CFBundleVersion"] as? String) ?? "") ?? 0
+    var request = URLRequest(url: url)
+    request.cachePolicy = .reloadIgnoringLocalCacheData
+    request.timeoutInterval = 20
+    URLSession.shared.dataTask(with: request, completionHandler: { data, _, _ in
+        let release = data.flatMap(prismGramParseRelease)
+        DispatchQueue.main.async {
+            let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+            let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru") || presentationData.strings.baseLanguageCode.hasPrefix("uk")
+            let alert: ViewController
+            if let release = release, release.build > currentBuild {
+                alert = textAlertController(
+                    context: context,
+                    title: ru ? "Доступно обновление" : "Update available",
+                    text: ru
+                        ? "PrismGram \(release.version) (\(release.build)). У вас сборка \(currentBuild).\n\nСкачайте IPA и установите его через Feather или другой подписыватель. Если источник PrismGram добавлен в Feather, обновление уже там."
+                        : "PrismGram \(release.version) (\(release.build)). You have build \(currentBuild).\n\nDownload the IPA and install it with Feather or another signer. If the PrismGram source is added to Feather, the update is already there.",
+                    actions: [
+                        TextAlertAction(type: .genericAction, title: ru ? "Позже" : "Later", action: {}),
+                        TextAlertAction(type: .defaultAction, title: ru ? "Скачать" : "Download", action: {
+                            context.sharedContext.applicationBindings.openUrl(release.downloadURL)
+                        })
+                    ],
+                    actionLayout: .vertical
+                )
+            } else if manual {
+                let text: String
+                if release == nil {
+                    text = ru ? "Не удалось проверить обновления. Проверьте интернет и попробуйте ещё раз." : "Couldn't check for updates. Check your connection and try again."
+                } else {
+                    text = ru ? "У вас последняя версия PrismGram." : "You have the latest version of PrismGram."
+                }
+                alert = textAlertController(context: context, title: nil, text: text, actions: [TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})])
+            } else {
+                return
+            }
+            context.sharedContext.mainWindow?.present(alert, on: .root)
+        }
+    }).resume()
+}
