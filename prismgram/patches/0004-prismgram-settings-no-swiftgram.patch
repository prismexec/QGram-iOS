diff --git a/Swiftgram/SGSettingsUI/Sources/PrismGramSettingsController.swift b/Swiftgram/SGSettingsUI/Sources/PrismGramSettingsController.swift
new file mode 100644
index 00000000..caac9443
--- /dev/null
+++ b/Swiftgram/SGSettingsUI/Sources/PrismGramSettingsController.swift
@@ -0,0 +1,106 @@
+// MARK: PrismGram
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import AccountContext
+import SGItemListUI
+import SGSimpleSettings
+
+private enum PrismGramSection: Int32, SGItemListSection {
+    case ghost
+    case history
+    case other
+    case about
+}
+
+private enum PrismGramToggle: String {
+    case ghostMode
+    case noReadReceipts
+    case noOnline
+    case noTyping
+    case noStoryViews
+    case readOnReply
+    case saveDeletedMessages
+    case saveEditHistory
+    case hideSponsoredMessages
+}
+
+private typealias PrismGramEntry = SGItemListUIEntry<PrismGramSection, PrismGramToggle, AnyHashable, AnyHashable, AnyHashable, AnyHashable>
+
+private func prismGramEntries(presentationData: PresentationData) -> [PrismGramEntry] {
+    let lang = presentationData.strings.baseLanguageCode
+    let ru = lang.hasPrefix("ru") || lang.hasPrefix("uk")
+    let settings = SGSimpleSettings.shared
+    let id = SGItemListCounter()
+    var entries: [PrismGramEntry] = []
+
+    entries.append(.header(id: id.count, section: .ghost, text: ru ? "РЕЖИМ ПРИЗРАКА" : "GHOST MODE", badge: nil))
+    entries.append(.toggle(id: id.count, section: .ghost, settingName: .ghostMode, value: settings.prismGhostModeEnabled, text: ru ? "👻 Режим призрака" : "👻 Ghost Mode", enabled: true))
+    entries.append(.toggle(id: id.count, section: .ghost, settingName: .noReadReceipts, value: settings.prismGhostNoReadReceipts, text: ru ? "Не отправлять прочтение" : "Don't send read receipts", enabled: true))
+    entries.append(.toggle(id: id.count, section: .ghost, settingName: .noOnline, value: settings.prismGhostNoOnline, text: ru ? "Не отправлять «в сети»" : "Don't send online status", enabled: true))
+    entries.append(.toggle(id: id.count, section: .ghost, settingName: .noTyping, value: settings.prismGhostNoTyping, text: ru ? "Не отправлять «печатает»" : "Don't send typing status", enabled: true))
+    entries.append(.toggle(id: id.count, section: .ghost, settingName: .noStoryViews, value: settings.prismGhostNoStoryViews, text: ru ? "Не отмечать истории просмотренными" : "Don't mark stories as viewed", enabled: true))
+    entries.append(.toggle(id: id.count, section: .ghost, settingName: .readOnReply, value: settings.prismGhostReadOnReply, text: ru ? "Читать при ответе" : "Read on reply", enabled: settings.prismGhostNoReadReceipts))
+    entries.append(.notice(id: id.count, section: .ghost, text: ru
+        ? "Собеседник не увидит, что вы прочитали сообщения, что вы в сети и что печатаете. «Читать при ответе»: когда вы пишете в чат, он отмечается прочитанным. Отправить прочтение вручную — удерживайте чат или сообщение → «👻 Отправить прочтение». Быстро включить режим — удерживайте вкладку «Чаты»."
+        : "Others won't see that you read their messages, that you are online or typing. \"Read on reply\" marks a chat as read when you write to it. To send a read receipt manually, long-press a chat or a message → \"👻 Send Read Receipt\". Long-press the Chats tab to toggle ghost mode quickly."))
+
+    entries.append(.header(id: id.count, section: .history, text: ru ? "ИСТОРИЯ СООБЩЕНИЙ" : "MESSAGE HISTORY", badge: nil))
+    entries.append(.toggle(id: id.count, section: .history, settingName: .saveDeletedMessages, value: settings.prismSaveDeletedMessages, text: ru ? "Сохранять удалённые сообщения" : "Keep deleted messages", enabled: true))
+    entries.append(.toggle(id: id.count, section: .history, settingName: .saveEditHistory, value: settings.prismSaveEditHistory, text: ru ? "Сохранять историю правок" : "Keep edit history", enabled: true))
+    entries.append(.notice(id: id.count, section: .history, text: ru
+        ? "Удалённые сообщения остаются в чате с меткой 🗑. Старые версии изменённых сообщений — в меню сообщения → «История правок». Работает для сообщений, которые уже загрузились на устройство."
+        : "Deleted messages stay in the chat marked with 🗑. Previous versions of edited messages are in the message menu → Edit History. Works for messages already loaded on this device."))
+
+    entries.append(.header(id: id.count, section: .other, text: ru ? "ДРУГОЕ" : "OTHER", badge: nil))
+    entries.append(.toggle(id: id.count, section: .other, settingName: .hideSponsoredMessages, value: settings.prismHideSponsoredMessages, text: ru ? "Скрывать рекламу в каналах" : "Hide sponsored messages", enabled: true))
+
+    let version = (Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String) ?? ""
+    let build = (Bundle.main.infoDictionary?["CFBundleVersion"] as? String) ?? ""
+    entries.append(.notice(id: id.count, section: .about, text: "PrismGram \(version) (\(build))"))
+
+    return entries
+}
+
+public func prismGramSettingsController(context: AccountContext) -> ViewController {
+    let reloadPromise = ValuePromise(true, ignoreRepeated: false)
+
+    let arguments = SGItemListArguments<PrismGramToggle, AnyHashable, AnyHashable, AnyHashable, AnyHashable>(context: context, setBoolValue: { setting, value in
+        let settings = SGSimpleSettings.shared
+        switch setting {
+        case .ghostMode:
+            settings.prismGhostModeEnabled = value
+        case .noReadReceipts:
+            settings.prismGhostNoReadReceipts = value
+        case .noOnline:
+            settings.prismGhostNoOnline = value
+        case .noTyping:
+            settings.prismGhostNoTyping = value
+        case .noStoryViews:
+            settings.prismGhostNoStoryViews = value
+        case .readOnReply:
+            settings.prismGhostReadOnReply = value
+        case .saveDeletedMessages:
+            settings.prismSaveDeletedMessages = value
+        case .saveEditHistory:
+            settings.prismSaveEditHistory = value
+        case .hideSponsoredMessages:
+            settings.prismHideSponsoredMessages = value
+        }
+        // Ghost mode switches depend on each other, redraw the whole list.
+        reloadPromise.set(true)
+    })
+
+    let signal = combineLatest(reloadPromise.get(), context.sharedContext.presentationData)
+    |> map { _, presentationData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("PrismGram"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: prismGramEntries(presentationData: presentationData), style: .blocks, ensureVisibleItemTag: nil, initialScrollToItem: nil)
+        return (controllerState, (listState, arguments))
+    }
+
+    return ItemListController(context: context, state: signal)
+}
